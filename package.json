{
  "name": "@jangmanj/pi-bgtasks",
  "version": "0.1.0",
  "description": "Background shell tasks and declared in-process subagents for Pi: bg_run, bg_logs, bg_kill, subagent.",
  "license": "MIT",
  "author": "JangMan-J",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "background-tasks",
    "subagents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "init-package": "node scripts/init-package.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "~22.19.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-bgtasks.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-bgtasks#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-bgtasks/issues"
  }
}
